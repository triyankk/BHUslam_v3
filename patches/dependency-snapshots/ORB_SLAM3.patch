 namespace ORB_SLAM3
 {
+namespace {
+std::atomic<unsigned> bhuActiveGBA{0};
+std::thread* StartTrackedGBA(LoopClosing* loop, Map* map, unsigned long keyframe) {
+    ++bhuActiveGBA;
+    try {
+        return new std::thread([=] {
+            struct Finished { ~Finished() { --bhuActiveGBA; } } finished;
+            loop->RunGlobalBundleAdjustment(map, keyframe);
+        });
+    } catch (...) { --bhuActiveGBA; throw; }
+}
+}
+bool BHU_GlobalBAActive() { return bhuActiveGBA.load()!=0; }
 
