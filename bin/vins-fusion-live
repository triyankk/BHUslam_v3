#!/usr/bin/env bash
set -euo pipefail
bhu_workspace="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$bhu_workspace/scripts/env.sh"
export LD_LIBRARY_PATH="$bhu_workspace/third_party/vins-deps/install/lib:$bhu_workspace/third_party/vins-deps/sysroot/usr/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH"
# Selected native frontend profile; explicit experiment flags always win.
if (( $# >= 3 )); then
  for fusion_option in --opencv-threads --max-features --feature-distance --stereo-policy; do
    fusion_option_set=false
    for fusion_arg in "${@:4}"; do
      if [[ "$fusion_arg" == "$fusion_option" ]]; then fusion_option_set=true; fi
    done
    if [[ "$fusion_option_set" == false ]]; then
      case "$fusion_option" in
        --opencv-threads) set -- "$@" "$fusion_option" 4 ;;
        --max-features) set -- "$@" "$fusion_option" 200 ;;
        --feature-distance) set -- "$@" "$fusion_option" 25 ;;
        --stereo-policy) set -- "$@" "$fusion_option" rectified ;;
      esac
    fi
  done
fi
exec "$bhu_workspace/build/vins-fusion/bin/vins_fusion_live" "$@"
