[Unit]
Description=QR-triggered Gemini VIO bench test with Cube buzzer feedback
Documentation=file:%h/BHUslamV3/docs/cube-vio-test.md
ConditionFileIsExecutable=%h/BHUslamV3/build/main/bin/gemini_live
Conflicts=bhu-vio-test.service

[Service]
Type=simple
WorkingDirectory=%h/BHUslamV3
ExecStartPre=/bin/bash %h/BHUslamV3/scripts/wait-vio-devices.sh 120
ExecStart=%h/BHUslamV3/bin/vio-test cube-arm
TimeoutStartSec=150
KillSignal=SIGINT
KillMode=mixed
SuccessExitStatus=130 143
TimeoutStopSec=180
Restart=no
UMask=0027
StandardOutput=append:%h/BHUslamV3/runs/cube-boot.log
StandardError=inherit

[Install]
WantedBy=default.target
